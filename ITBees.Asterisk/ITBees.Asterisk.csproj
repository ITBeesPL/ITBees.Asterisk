<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ITBees.Asterisk</PackageId>
    <Version>8.0.2</Version>
    <Authors>ITBees</Authors>
    <Description>Control library for an Asterisk PBX running next to an application (Octopark parking columns and servers). Declarative configuration package (PJSIP extensions for Fanvil PA2S / X3SP, Yealink T30P and WebRTC browser phones, ring groups, intercom auto-answer, hotlines, SIP trunks, outbound routes) rendered to pjsip.conf / extensions.conf / manager.conf / rtp.conf / http.conf, idempotent apply with plan (dry run), package installation and service control on the host, AMI client (status, endpoints, contacts, channels, originate, hangup, reload, CLI commands) and phone setup sheets.</Description>
    <PackageTags>asterisk;pbx;sip;pjsip;ami;voip;fanvil;yealink;webrtc;itbees;octopark</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ITBeesPL/ITBees.Asterisk</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ITBees.Asterisk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Host\install-from-source.sh" LogicalName="ITBees.Asterisk.install-from-source.sh" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
